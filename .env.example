# OpenWeatherMap API 키 (https://openweathermap.org/api 에서 발급)
VITE_OPENWEATHER_API_KEY=your_api_key_here
VITE_OPENWEATHER_BASE_URL=https://api.openweathermap.org

# 관전 플랜 저장소 + 구글 로그인 (Google Cloud / Firebase)
# 비워두면 플랜은 이 기기에만 저장되고 알림 메일은 발송되지 않습니다.
# 설정 방법은 functions/README.md 참고
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
# Firebase에서 Google 로그인을 켜면 자동 생성되는 웹 클라이언트 ID
VITE_GOOGLE_CLIENT_ID=
