rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 관전 플랜
    // 읽기: 로그인한 사람은 모두의 플랜을 볼 수 있다.
    // 쓰기: 자기 문서만 만들고 고치고 지울 수 있다.
    match /plans/{planId} {

      function signedIn() {
        return request.auth != null;
      }

      // 이미 저장된 문서의 주인인지
      function isOwner() {
        return signedIn() && resource.data.ownerUid == request.auth.uid;
      }

      // 새로 쓰는 내용이 본인 것으로 표시돼 있는지
      function claimsSelf() {
        return signedIn() && request.resource.data.ownerUid == request.auth.uid;
      }

      // 목록이 공개이므로 이메일 같은 연락처는 문서에 담지 못하게 막는다.
      // 알림은 계정 주소로만 나가고, 그 주소는 발송 시점에 함수가 Auth에서 읽는다.
      function noContactInfo() {
        return !request.resource.data.keys().hasAny(['email', 'phone']);
      }

      function validShape() {
        let d = request.resource.data;
        return d.notify is bool
          && d.nickname is string && d.nickname.size() > 0 && d.nickname.size() <= 20
          && d.circuitId is string && d.circuitId.size() < 100
          && d.people is int && d.people >= 1 && d.people <= 10
          && d.memo is string && d.memo.size() <= 40;
      }

      allow read: if signedIn();

      allow create: if claimsSelf() && noContactInfo() && validShape();

      // 수정 시 주인이 바뀌지 않도록 이전/이후 모두 확인
      allow update: if isOwner() && claimsSelf() && noContactInfo() && validShape();

      allow delete: if isOwner();
    }

    // 그 외 모든 문서는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
